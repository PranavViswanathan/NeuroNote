# Copy this file to infra/.env.prod and fill in real values.
# Never commit .env.prod to version control.

# Your public domain (must have an A record pointing to the VPS IP)
DOMAIN=notes.example.com

# Shared access token — sent as X-Api-Key by all browser clients.
# Generate with: openssl rand -hex 32
API_KEY=

# LLM provider key (required for AI extraction and concept insights).
# Anthropic: sk-ant-...   OpenAI: sk-...   Groq: gsk_...   Ollama: any string
LLM_API_KEY=

# LLM endpoint — any OpenAI-compatible base URL.
# Anthropic (default): https://api.anthropic.com/v1/
# OpenAI:              https://api.openai.com/v1
# Groq:                https://api.groq.com/openai/v1
# Ollama (local):      http://localhost:11434/v1
LLM_BASE_URL=

# PostgreSQL password for the neuronote DB user.
# Generate with: openssl rand -hex 32
DB_PASSWORD=

# NLP extraction profile: rule-only | hybrid-spacy | llm-enhanced
# llm-enhanced gives the best concept extraction and enables the insight panel.
NLP_EXTRACTION_PROFILE=llm-enhanced

# Password gate for the web UI.
# If set, visitors must enter this password before accessing the app.
# Leave empty to disable the gate (open access).
APP_PASSWORD=

# Secret used to sign session cookies — must be set when APP_PASSWORD is set.
# Generate with: openssl rand -hex 32
SESSION_SECRET=
