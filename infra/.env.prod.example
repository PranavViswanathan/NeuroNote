# Copy this file to infra/.env.prod and fill in real values.
# Never commit .env.prod to version control.

# Your public domain (must have an A record pointing to the VPS IP)
DOMAIN=notes.example.com

# Shared access token — sent as X-Api-Key by all browser clients.
# Share this with friends/family alongside the URL.
# Generate with: openssl rand -hex 32
API_KEY=

# Your Anthropic API key — stays server-side only, never reaches the browser.
ANTHROPIC_API_KEY=sk-ant-

# PostgreSQL password for the neuronote DB user.
# Generate with: openssl rand -hex 32
DB_PASSWORD=

# NLP extraction profile: rule-only | hybrid-spacy | llm-enhanced
# llm-enhanced gives the best concept extraction and enables the insight panel.
NLP_EXTRACTION_PROFILE=llm-enhanced
