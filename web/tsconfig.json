{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "es2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": false,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
